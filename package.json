{
  "name": "chronica-omnium",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "data:build": "node scripts/build-data.mjs",
    "catalog": "node scripts/catalog.mjs",
    "editor:check": "node scripts/check-local-editor.mjs",
    "sources:sync": "node scripts/sync-sources.mjs",
    "content:export": "node scripts/export-content.mjs",
    "pretest": "node scripts/build-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "research": "node scripts/research.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
